# AlphaDesk environment configuration

# Database. Leave DATABASE_URL unset to use the local SQLite fallback (data/alphadesk.db).
# For PostgreSQL (used by docker-compose), use the form below.
# DATABASE_URL=postgresql+psycopg://alphadesk:alphadesk@localhost:5432/alphadesk

# Risk-free rate used in Sharpe / Sortino, annualised.
RISK_FREE_RATE=0.065

# Logging
LOG_LEVEL=INFO

# Ingestion
MFAPI_BASE_URL=https://api.mfapi.in/mf
MFAPI_REQUEST_DELAY_MS=250
MFAPI_MAX_RETRIES=4
INGEST_MAX_WORKERS=4

# API server
API_HOST=0.0.0.0
API_PORT=8000
